  "cards": [
    {
      "dot": "cyan",
      "title": "Repository split",
      "items": [
        "kernel is standard-library only: lifecycle, scopes, services, points, settings",
        "contract/shell declares Pages, Strip, TitleBar, Overlays and HostKey",
        "shell, native, settings and inspector ship with the kit; apps own main and plugins, and the kit never imports them"
      ]
    },
    {
      "dot": "emerald",
      "title": "Frame and thread rules",
      "items": [
        "Shell.View reads each point and calls kernel.Invoke, so a panicking view fails only its plugin",
        "Render builds elements and performs no I/O or kernel mutation; handlers do the work",
        "Workers run through kernel.Go or Scope.Spawn, never a bare goroutine"
      ]
    },
    {
      "dot": "rose",
      "title": "State, failure and tests",
      "items": [
        "Settings are namespaced JSON in settings.db; writes are batched on a worker",
        "A failed Setup disposes what it registered; a run-time failure can restart within its policy",
        "kittest fakes shell.Host and guards palette colors and goroutines; examples/notes is the reference app"
      ]
    }
  ]
}
